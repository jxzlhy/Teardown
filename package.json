  "description": "格物馆（原 DJI 拆解馆）· 多设备 3D 交互拆解数字博物馆",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "GEWU_RELEASE=1 vite build",
    "preview": "vite preview",
