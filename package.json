    "gen:graph": "node tools/gen-knowledge-graph.mjs",
    "gen:timeline": "node tools/gen-timeline.mjs",
    "lint:devices": "node tools/lint-mapping.mjs && node tools/lint-knowledge.mjs && node tools/lint-mech.mjs && node tools/lint-consistency.mjs && node tools/lint-hooks.mjs && node tools/lint-assets.mjs",
    "verify:contrast": "node tools/contrast-verify.mjs --base http://127.0.0.1:8200 --max 0",
    "smoke": "node tools/smoke.mjs",
    "thumbs": "node tools/render-thumbs.mjs",
    "add": "node tools/addDevice.mjs",
    "optimize": "node tools/optimize-glb.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "gsap": "^3.15.0",
    "three": "^0.164.0",
    "three-mesh-bvh": "^0.9.17",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "puppeteer-core": "^25.16.0",
    "vite": "^5.4.21"
